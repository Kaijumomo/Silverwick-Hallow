{
  "rootId": "grim-screen",
  "rootStyle": "position:absolute; inset:0; display:flex; overflow:hidden; background:#0b0909; font-family:'Source Sans 3', system-ui, sans-serif; font-variant-numeric:lining-nums tabular-nums; color:#ddd6c8;",
  "dropStyleHas": [
    "{{ panel.pos }}"
  ],
  "templatePatches": [
    {
      "regex": "WICK(<span style=\"color:rgba\\(232,88,74,\\.7\\); letter-spacing:0; margin:0 \\.3em 0 \\.1em;\">\u2013</span>)7Q3M",
      "replace": "{{ code.head }}$1{{ code.tail }}"
    },
    {
      "regex": "<span aria-label=\"Game code WICK7Q3M\" style=\"([^\"]*)\"><span style=\"([^\"]*)\">W</span>(?:<span style=\"[^\"]*\">[ICK]</span>){3}(<span aria-hidden=\"true\"[^>]*></span>)(?:<span style=\"[^\"]*\">[7Q3M]</span>){4}</span>",
      "replace": "<span aria-label=\"{{ code.aria }}\" style=\"$1\"><sc-for list=\"{{ code.headChars }}\" as=\"ch\"><span style=\"$2\">{{ ch }}</span></sc-for>$3<sc-for list=\"{{ code.tailChars }}\" as=\"ch\"><span style=\"$2\">{{ ch }}</span></sc-for></span>"
    },
    {
      "regex": "silverwick\\.app/join",
      "replace": "{{ code.host }}"
    },
    {
      "regex": "<img src=\"https://release\\.botc\\.app/resources/characters/tb/imp_e\\.webp\"([^>]*)>",
      "replace": "<sc-if value=\"{{ scriptEmblem }}\"><img src=\"{{ scriptEmblem }}\"$1></sc-if>"
    },
    {
      "regex": "(<div style=\"display:flex; align-items:center; gap:8px; margin-top:2px;\">\\s*<button onClick=\"\\{\\{ prevStep \\}\\}\" style=\"height:44px)",
      "replace": "<sc-if value=\"{{ night.hasCustom }}\"><div style=\"display:flex; flex-direction:column; gap:10px;\">{{ night.custom }}</div></sc-if>$1"
    },
    {
      "regex": ">Trouble Brewing</span>(<span style=\"font-size:13px;[^>]*>\\{\\{ refM\\.count \\}\\} characters)",
      "replace": ">{{ refM.script }}</span>$1"
    },
    {
      "regex": "(<a href=\"\\{\\{ refM\\.sel\\.wiki \\}\\}\".*?</svg></a>)",
      "replace": "<sc-if value=\"{{ refM.sel.hasWiki }}\">$1</sc-if>",
      "flags": "s"
    },
    {
      "regex": "(<div style=\"display:grid; grid-template-columns:minmax\\(0,1fr\\) minmax\\(0,1fr\\); gap:10px;\">\\s*<button onClick=\"\\{\\{ endDlg\\.good \\}\\}\".*?Evil wins</button>\\s*</div>)(\\s*<button onClick=\"\\{\\{ endDlg\\.close \\}\\}\"[^>]*>Keep playing</button>)",
      "replace": "<sc-if value=\"{{ endDlg.notice }}\"><div style=\"font-size:13px; line-height:1.45; color:rgba(222,216,204,.65);\">{{ endDlg.notice }}</div></sc-if><sc-if value=\"{{ endDlg.choices }}\">$1</sc-if><sc-if value=\"{{ endDlg.recovery }}\"><button onClick=\"{{ endDlg.retry }}\" style=\"min-height:52px; border-radius:14px; border:1px solid rgba(224,200,140,.5); background:rgba(224,200,140,.08); color:#ecd9a8; font-family:'IM Fell English', serif; font-size:22px; font-weight:400; cursor:pointer;\" style-hover=\"background:rgba(224,200,140,.16);\">Retry saving result</button></sc-if><sc-if value=\"{{ endDlg.error }}\"><div role=\"alert\" style=\"font-size:13px; line-height:1.4; color:#f4a595;\">{{ endDlg.error }}</div></sc-if>$2<sc-if value=\"{{ endDlg.choices }}\"><button onClick=\"{{ endDlg.noResult }}\" style=\"align-self:center; margin-top:-12px; min-height:36px; padding:0 18px; border:none; background:transparent; color:rgba(222,216,204,.45); font-family:inherit; font-size:12px; cursor:pointer;\" style-hover=\"color:#ece6da;\">End without a result</button></sc-if>",
      "flags": "s"
    },
    {
      "_why": "The Card nomination result button names the next step (Next nomination / Exiled \u00b7 died / Execute \u00b7 died / Begin Night N / Use current table ...). Default text stays 'Next nomination'.",
      "regex": "(style=\"flex:none; min-height:48px; padding:0 22px; border-radius:12px; border:1px solid #c0392e;[^\"]*\"[^>]*>)Next nomination(</button>)",
      "replace": "$1{{ ns.nextText }}$2"
    },
    {
      "_why": "One slot at the foot of the Card nomination for the follow-ups the design has no face for (Virgin, exile, execution outcome, refusal text). Rendered by day/NominationExtras.tsx in the card's own button style.",
      "regex": "(<span style=\"font-family:'IM Fell English', serif; font-size:16px; color:rgba\\(236,230,218,\\.75\\);\">\\{\\{ ns\\.resultSub \\}\\}</span>\\s*</div>\\s*<button onClick=\"\\{\\{ ns\\.next \\}\\}\"[^>]*>\\{\\{ ns\\.nextText \\}\\}</button>\\s*</div>\\s*</sc-if>)(\\s*</div>\\s*</div>\\s*</sc-if>\\s*<sc-if value=\"\\{\\{ ns\\.scrollOn \\}\\}\")",
      "replace": "$1\n        <sc-if value=\"{{ ns.extraOn }}\" hint-placeholder-val=\"{{ false }}\">{{ ns.extra }}</sc-if>$2"
    },
    {
      "_why": "The Storyteller's own confirm / name-entry dialog (Remove from Game, offline Add player), in the End dialog's panel language, replacing the browser's native dialogs.",
      "regex": "(\\s*)(<sc-if value=\"\\{\\{ endDlg\\.open \\}\\}\")",
      "replace": "$1<sc-if value=\"{{ askDlg.open }}\" hint-placeholder-val=\"{{ false }}\">\n    <div onClick=\"{{ askDlg.close }}\" style=\"position:absolute; inset:0; z-index:95; background:rgba(6,4,5,.6); backdrop-filter:blur(3px); display:flex; align-items:center; justify-content:center; animation:swRise .25s ease-out;\">\n      <div role=\"dialog\" aria-label=\"{{ askDlg.title }}\" onClick=\"{{ stop }}\" style=\"width:380px; max-width:calc(100% - 48px); padding:24px; border-radius:20px; background:linear-gradient(180deg, rgba(34,24,28,.98), rgba(12,13,20,.98)); border:1px solid rgba(176,186,204,.28); box-shadow:0 30px 80px rgba(0,0,0,.6); display:flex; flex-direction:column; gap:16px; text-align:center;\">\n        <div style=\"display:flex; flex-direction:column; gap:6px;\">\n          <div style=\"font-family:'Cinzel Decorative', serif; font-size:24px; font-weight:700; color:#ecd9a8;\">{{ askDlg.title }}</div>\n          <div style=\"font-size:14px; line-height:1.45; color:rgba(222,216,204,.65);\">{{ askDlg.body }}</div>\n        </div>\n        <sc-if value=\"{{ askDlg.hasInput }}\" hint-placeholder-val=\"{{ false }}\">\n          <input autofocus=\"{{ askDlg.open }}\" value=\"{{ askDlg.value }}\" onInput=\"{{ askDlg.onInput }}\" onKeyDown=\"{{ askDlg.onKey }}\" maxlength=\"{{ askDlg.maxLength }}\" placeholder=\"{{ askDlg.placeholder }}\" aria-label=\"{{ askDlg.placeholder }}\" style=\"width:100%; box-sizing:border-box; height:44px; padding:0 14px; border-radius:10px; border:1px solid rgba(176,186,204,.26); background:rgba(9,10,15,.7); color:#f2ece0; font-family:inherit; font-size:15px; outline:none;\" style-focus=\"border-color:#c0392e;\">\n        </sc-if>\n        <button onClick=\"{{ askDlg.ok }}\" disabled=\"{{ askDlg.okDisabled }}\" style=\"min-height:52px; border-radius:14px; border:1px solid rgba(217,122,108,.4); background:rgba(217,122,108,.08); color:#eba597; font-family:'IM Fell English', serif; font-size:22px; font-weight:400; cursor:pointer;\" style-hover=\"background:rgba(217,122,108,.16); border-color:#e88a7a;\">{{ askDlg.okText }}</button>\n        <button onClick=\"{{ askDlg.close }}\" style=\"align-self:center; margin-top:-4px; min-height:44px; padding:0 18px; border:none; background:transparent; color:rgba(222,216,204,.6); font-family:inherit; font-size:14px; cursor:pointer;\" style-hover=\"color:#ece6da;\">Cancel</button>\n      </div>\n    </div>\n  </sc-if>\n  $2"
    },
    {
      "_why": "Return Home sits beside Review the Grimoire on the victory scene, in the same button style (PO Gate 2 decision 2). The finished game stays stored and reviewable from Home.",
      "regex": "<button\\ onClick=\"\\{\\{\\ win\\.close\\ \\}\\}\"\\ style=\"margin\\-top:10px;\\ min\\-height:52px;\\ padding:0\\ 28px;\\ border\\-radius:26px;\\ border:1px\\ solid\\ \\{\\{\\ win\\.ring\\ \\}\\};\\ background:rgba\\(0,0,0,\\.35\\);\\ color:\\{\\{\\ win\\.titleColor\\ \\}\\};\\ font\\-family:'IM\\ Fell\\ English',\\ serif;\\ font\\-size:20px;\\ font\\-weight:400;\\ cursor:pointer;\"\\ style\\-hover=\"background:rgba\\(255,240,210,\\.08\\);\">Review\\ the\\ Grimoire</button>",
      "replace": "<div style=\"display:flex; flex-wrap:wrap; justify-content:center; gap:14px;\"><button onClick=\"{{ win.close }}\" style=\"margin-top:10px; min-height:52px; padding:0 28px; border-radius:26px; border:1px solid {{ win.ring }}; background:rgba(0,0,0,.35); color:{{ win.titleColor }}; font-family:'IM Fell English', serif; font-size:20px; font-weight:400; cursor:pointer;\" style-hover=\"background:rgba(255,240,210,.08);\">Review the Grimoire</button><button onClick=\"{{ win.home }}\" style=\"margin-top:10px; min-height:52px; padding:0 28px; border-radius:26px; border:1px solid {{ win.ring }}; background:rgba(0,0,0,.35); color:{{ win.titleColor }}; font-family:'IM Fell English', serif; font-size:20px; font-weight:400; cursor:pointer;\" style-hover=\"background:rgba(255,240,210,.08);\">Return Home</button></div>"
    },
    {
      "_why": "PO review A08: the dock hugs its buttons (no empty band beside Undo) and shifts by half the side difference so the phase button stays on the centre line.",
      "regex": "(<div style=\"pointer-events:auto; display:grid; grid-template-columns:)minmax\\(0,1fr\\) 150px minmax\\(0,1fr\\);",
      "replace": "$1auto 150px auto; translate:{{ dockShift }}px 0;"
    },
    {
      "_why": "PO review A03 (reference 'v6-selection'): an impaired (drunk or poisoned) player shows a 'Poisoned \u00b7 any info' pill beside their name on the Night card.",
      "regex": "(<span style=\"font-size:13px; color:rgba\\(222,216,204,\\.6\\);\">\\{\\{ night\\.cur\\.who \\}\\}</span>)",
      "replace": "$1<sc-if value=\"{{ night.cur.impOn }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"align-self:center; display:inline-flex; align-items:center; gap:6px; padding:3px 10px; border-radius:99px; border:1px solid rgba(180,140,224,.55); background:rgba(120,80,170,.2); font-size:13px; color:rgba(222,216,204,.7);\"><span style=\"width:7px; height:7px; border-radius:50%; background:#b48ce0;\"></span><span style=\"font-weight:700; color:#efe6fa;\">{{ night.cur.impLabel }}</span>\u00b7 any info</span></sc-if>"
    }
  ]
}

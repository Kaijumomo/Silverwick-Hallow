{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--executable-path",
        "${PLAYWRIGHT_MCP_EXECUTABLE_PATH:-/opt/pw-browsers/chromium}"
      ],
      "env": {
        "PLAYWRIGHT_MCP_SANDBOX": "${PLAYWRIGHT_MCP_SANDBOX:-false}"
      }
    }
  }
}

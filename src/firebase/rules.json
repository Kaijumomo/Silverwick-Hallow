{
  "rules": {
    "lobbies": {
      "$code": {
        "storytellerUid": {
          ".read": "auth != null",
          ".write": "auth != null && newData.val() === auth.uid && ((!data.exists() && !data.parent().exists()) || data.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "joinRequests": {
          ".read": "auth != null && root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid)",
            ".write": "auth != null && ((root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid && !newData.exists()) || ($uid === auth.uid && (!newData.exists() || (!data.exists() && root.child('lobbies').child($code).child('storytellerUid').isString() && root.child('lobbies').child($code).child('public').child('status').val() !== 'ended' && !root.child('lobbies').child($code).child('roster').child(auth.uid).exists()))))",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20 && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().contains('\\n') && !newData.val().contains('\\r') && !newData.val().contains('\\t')"
          }
        },
        "roster": {
          ".read": "auth != null && root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid || $uid === auth.uid)",
            ".write": "auth != null && root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0"
          }
        },
        "public": {
          ".read": "auth != null && (root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid || root.child('lobbies').child($code).child('roster').child(auth.uid).exists() || root.child('lobbies').child($code).child('joinRequests').child(auth.uid).exists())",
          ".write": "auth != null && root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid"
        },
        "player": {
          "$playerId": {
            ".read": "auth != null && (root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid || root.child('lobbies').child($code).child('roster').child(auth.uid).val() === $playerId)",
            ".write": "auth != null && root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid"
          }
        },
        "presence": {
          "$uid": {
            ".read": "auth != null && (root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid || root.child('lobbies').child($code).child('roster').child(auth.uid).exists())",
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['online', 'lastSeen'])"
          }
        },
        "storyteller": {
          ".read": "auth != null && root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid",
          ".write": "auth != null && root.child('lobbies').child($code).child('storytellerUid').val() === auth.uid"
        }
      }
    }
  }
}
